# =============================================================================
# GMAO SaaS — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles
# NE JAMAIS commiter .env.local ou .env avec des vraies valeurs
# =============================================================================

# Environnement applicatif (development | staging | production | debug)
APP_ENV=development

# --- Base de données (Neon PostgreSQL) ---
# URL poolée pour les requêtes applicatives
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# URL directe (non-poolée) pour les migrations Prisma
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# --- Authentification (Better Auth) ---
# Clé secrète aléatoire, minimum 32 caractères
BETTER_AUTH_SECRET=changeme_generate_a_random_32_char_string_here
# URL publique de l'application
BETTER_AUTH_URL=http://localhost:3000

# --- IA (Groq) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Email (Resend) — optionnel ---
# Créer un compte sur https://resend.com (gratuit ≤ 3000 emails/mois)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=MekaSuite <noreply@mekasuite.fr>
# Secret pour protéger la route cron /api/cron/check-overdue
CRON_SECRET=changeme_generate_a_random_secret_here

# --- Logs ---
# Niveau de log : debug | info | warn | error
LOG_LEVEL=debug

# --- Super Admin ---
# Email du compte super admin (moi, le prestataire SaaS)
SUPER_ADMIN_EMAIL=admin@example.com
